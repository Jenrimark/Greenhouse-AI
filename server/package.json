{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file=../.env --import tsx/esm --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "dev:legacy": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node-pg-migrate up -m migrations",
    "migrate:down": "node-pg-migrate down -m migrations",
    "migrate:create": "node-pg-migrate create",
    "migrate:dbjson": "tsx scripts/migrate-dbjson.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "a1:smoke": "tsx scripts/a1-smoke.ts",
    "a2:smoke": "tsx scripts/a2-smoke.ts",
    "test:agent": "tsx --test tests/agent-tools.test.ts tests/agent-subgraphs.test.ts",
    "test:security": "tsx --test tests/agent-security.test.ts",
    "a4:smoke": "tsx scripts/a4-smoke.ts",
    "a5:smoke": "tsx scripts/a5-smoke.ts",
    "a6:smoke": "tsx scripts/a6-smoke.ts",
    "a9:smoke": "tsx scripts/a9-smoke.ts",
    "a10:perf": "tsx scripts/a10-perf.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.11",
    "@sentry/node": "^8.55.2",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/pino-http": "^5.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
