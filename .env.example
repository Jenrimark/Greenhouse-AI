# Greenhouse 环境变量模板：复制为 .env 后填写真实值，.env 不入库
# 部署方式：本地开发 / Docker Compose（docker-compose.yml 已引用本文件）

# ---- 运行环境 ----
NODE_ENV=development            # development | test | production
PORT=8787
LOG_LEVEL=info

# ---- 数据层 ----
# 本地：postgres://localhost:5432/greenhouse（docker compose 内为 postgres://postgres:postgres@postgres:5432/greenhouse）
DATABASE_URL=postgres://localhost:5432/greenhouse
# 本地：redis://localhost:6379（docker compose 内为 redis://redis:6379）
REDIS_URL=redis://localhost:6379

# ---- 会话 ----
COOKIE_NAME=gr_session
COOKIE_SECURE=false             # 生产（HTTPS）必须为 true
SESSION_TTL_DAYS=30

# ---- 种子管理员（仅部署时用）----
# 首次部署执行 `npm run seed:admin -w server` 时为 demo@greenroom.local 设置口令
# ADMIN_SEED_PASSWORD=请设置一个强口令

# ---- AI 供应商（阶段 2 Agent 使用；豆包方舟 / DeepSeek 均走 OpenAI 兼容端点）----
AGENT_PROVIDER=doubao
AGENT_MODEL=
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_FALLBACK_MODEL=
AGENT_FALLBACK_BASE_URL=
AGENT_FALLBACK_API_KEY=

# ---- 可观测（阶段 2 A9 接入）----
# SENTRY_DSN=
